From 915cd2c47333a46cfee957544d86d7a3654b6616 Mon Sep 17 00:00:00 2001
From: Gabriel Max <dev@zetta.app>
Date: Sat, 14 Nov 2026 03:50:38 +0100
Subject: [PATCH] Select mainline headphone routing while preserving legacy
 hotkeys

---
 src/main.rs | 10 ++++++++--
 1 file changed, 8 insertions(+), 2 deletions(-)

diff --git a/src/main.rs b/src/main.rs
index 1331d04..47d2a0c 100644
--- a/src/main.rs
+++ b/src/main.rs
@@ -205,8 +205,14 @@ fn process_event(
 
     }
     else if ev.event_code == EventCode::EV_SW(EV_SW::SW_HEADPHONE_INSERT) {
-        let dest = match ev.value { 1 => "SPK", _ => "HP" };
-        Command::new("amixer").args(&["-q", "sset", "'Playback Path'", dest]).output().expect("Failed to execute amixer");
+        let mainline = std::fs::read_to_string("/proc/sys/kernel/osrelease")
+            .map(|release| release.trim() == "7.3.4-v40.1").unwrap_or(false);
+        let (control, dest) = if mainline {
+            ("Playback Mux", if ev.value == 1 { "HP" } else { "SPK" })
+        } else {
+            ("'Playback Path'", if ev.value == 1 { "SPK" } else { "HP" })
+        };
+        Command::new("amixer").args(&["-q", "sset", control, dest]).output().expect("Failed to execute amixer");
     }
     else if ev.event_code == k.volume_up  && ev.value > 0 {
         Command::new("amixer").args(&["-q", "sset", "Playback", "1%+"]).output().expect("Failed to execute amixer");
-- 
