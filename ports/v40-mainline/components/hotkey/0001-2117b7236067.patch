new file mode 100644
index 0000000..ef2f0f2
--- /dev/null
+++ b/src/power_gate.rs
@@ -0,0 +1,48 @@
+// A wake key is queued while userspace is frozen. Detect actual suspend time
+// from BOOTTIME - MONOTONIC, independent of RTC and wall-clock adjustments.
+#[derive(Default)]
+pub struct PowerGate {
+    sleep_offset: Option<u64>,
+    quiet_until: u64,
+    down: bool,
+}
+impl PowerGate {
+    pub fn clock(&mut self, monotonic_ms: u64, boottime_ms: u64) -> bool {
+        let offset = boottime_ms.saturating_sub(monotonic_ms);
+        let resumed = self.sleep_offset.map_or(false, |old| offset > old.saturating_add(100));
+        self.sleep_offset = Some(offset);
+        if resumed {
+            self.quiet_until = monotonic_ms.saturating_add(1000);
+            self.down = false;
+        }
+        resumed
+    }
+    pub fn key(&mut self, value: i32, monotonic_ms: u64) -> bool {
+        if value == 0 { self.down = false; return false; }
+        if value != 1 || self.down { return false; }
+        self.down = true;
+        monotonic_ms >= self.quiet_until
+    }
+}
+#[cfg(test)]
+mod tests {
+    use super::*;
+    #[test] fn normal_press_release_and_repeat() {
+        let mut g=PowerGate::default(); g.clock(1000,1000);
+        assert!(g.key(1,1000)); assert!(!g.key(1,1001)); assert!(!g.key(2,1002));
+        assert!(!g.key(0,1003)); assert!(g.key(1,1100));
+    }
+    #[test] fn wake_press_does_not_resuspend() {
+        let mut g=PowerGate::default(); g.clock(1000,1000); assert!(g.key(1,1000)); g.key(0,1010);
+        assert!(g.clock(1100,11100)); assert!(!g.key(1,1100)); g.key(0,1110);
+        assert!(!g.key(1,1500)); g.key(0,1510); assert!(g.key(1,2200));
+    }
+    #[test] fn idle_poll_expires_wake_guard_before_later_press() {
+        let mut g=PowerGate::default(); g.clock(1000,1000); g.clock(1100,21100);
+        g.clock(1350,21350); g.clock(2350,22350); assert!(g.key(1,60000));
+    }
+    #[test] fn clock_sampling_jitter_is_not_resume() {
+        let mut g=PowerGate::default(); g.clock(1000,1001);
+        assert!(!g.clock(1100,1100)); assert!(!g.clock(1200,1202)); assert!(g.key(1,1200));
+    }
+}
