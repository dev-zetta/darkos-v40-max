+#ifdef V40_TRACE_DYNAREC
+static __attribute__((noinline)) int v40_recompile_block(int addr);
+
 int new_recompile_block(int addr)
+{
+  unsigned frame = sm64_hitch_active_frame ? sm64_hitch_active_frame() : 0;
+  struct v40_jit_timing *row;
+  uint64_t wall_before, cpu_before, wall_after, cpu_after, wall;
+  int result;
+
+  /* Count the outermost call so a nested compile is included only once. */
+  if (!frame || v40_jit_profiling)
+    return v40_recompile_block(addr);
+
+  v40_jit_profiling = 1;
+  wall_before = v40_jit_now(CLOCK_MONOTONIC);
+  cpu_before = v40_jit_now(CLOCK_THREAD_CPUTIME_ID);
+  result = v40_recompile_block(addr);
+  cpu_after = v40_jit_now(CLOCK_THREAD_CPUTIME_ID);
+  wall_after = v40_jit_now(CLOCK_MONOTONIC);
+  v40_jit_profiling = 0;
+  if (!wall_before || !cpu_before || wall_after < wall_before || cpu_after < cpu_before)
+    return result;
+
+  wall = wall_after - wall_before;
+  row = &v40_jit_rows[frame % (sizeof(v40_jit_rows) / sizeof(*v40_jit_rows))];
+  if (row->frame != frame)
+  {
+    memset(row, 0, sizeof(*row));
+    row->frame = frame;
+  }
+  row->block_count++;
+  row->wall_ns += wall;
+  row->cpu_ns += cpu_after - cpu_before;
+  if (wall > row->max_ns)
+  {
+    row->max_ns = wall;
+    row->slowest_pc = (unsigned)addr;
+  }
+  return result;
+}
