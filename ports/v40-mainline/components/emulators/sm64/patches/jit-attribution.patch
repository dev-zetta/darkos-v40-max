+struct v40_jit_timing
+{
+  unsigned frame, block_count, slowest_pc;
+  uint64_t wall_ns, cpu_ns, max_ns;
+};
+
+static struct v40_jit_timing v40_jit_rows[200];
+static _Thread_local int v40_jit_profiling;
+
+static uint64_t v40_jit_now(clockid_t clock_id)
+{
+  struct timespec now;
+  if (clock_gettime(clock_id, &now))
+    return 0;
+  return (uint64_t)now.tv_sec * 1000000000u + now.tv_nsec;
+}
+
+static void v40_jit_dump(void)
+{
+  unsigned i;
+  for (i = 0; i < sizeof(v40_jit_rows) / sizeof(*v40_jit_rows); ++i)
+  {
+    struct v40_jit_timing *row = &v40_jit_rows[i];
+    if (row->block_count)
+      fprintf(stderr, "V40_JIT frame=%u blocks=%u wall_ns=%llu cpu_ns=%llu max_ns=%llu slowest_pc=%08x\n",
+              row->frame, row->block_count,
+              (unsigned long long)row->wall_ns, (unsigned long long)row->cpu_ns,
+              (unsigned long long)row->max_ns, row->slowest_pc);
+  }
+  memset(v40_jit_rows, 0, sizeof(v40_jit_rows));
+}
