From ffeba6cd3d68fd33072b7997ca5327cc062594ae Mon Sep 17 00:00:00 2001
From: Codex <codex@local.invalid>
Date: Tue, 10 Nov 2026 20:19:07 +0100
Subject: [PATCH] Observe sleep requests during indefinite power-saver waits

---
 es-app/src/EmulationStation.h |  2 +-
 es-app/src/main.cpp           |  8 +++++++-
 es-core/src/RuntimeMedia.h    | 18 ++++++++++++++++++
 3 files changed, 26 insertions(+), 2 deletions(-)

diff --git a/es-app/src/EmulationStation.h b/es-app/src/EmulationStation.h
index 795bcfa..3034df9 100644
--- a/es-app/src/EmulationStation.h
+++ b/es-app/src/EmulationStation.h
@@ -10,7 +10,7 @@
 #define PROGRAM_VERSION_MAINTENANCE		0
 #define PROGRAM_VERSION_BUILD			0
 
-#define PROGRAM_VERSION_STRING "2.13.0.0 CHMOD +v40-runtime1"
+#define PROGRAM_VERSION_STRING "2.13.0.0 CHMOD +v40-runtime2"
 #define SCRAPER_VERSION_STRING "2.11.0.0"
 
 #define PROGRAM_BUILT_STRING __DATE__ " - " __TIME__
diff --git a/es-app/src/main.cpp b/es-app/src/main.cpp
index 11fd858..e6c20b6 100644
--- a/es-app/src/main.cpp
+++ b/es-app/src/main.cpp
@@ -730,7 +730,13 @@ int main(int argc, char* argv[])
 		SDL_Event event;
 		bool ps_standby = PowerSaver::getState() && (int) SDL_GetTicks() - ps_time > PowerSaver::getMode();
 
-		if (ps_standby ? SDL_WaitEventTimeout(&event, PowerSaver::getTimeout()) : SDL_PollEvent(&event))
+        const int gotEvent = ps_standby
+            ? RuntimeMedia::waitInterruptibly(
+                [&](int timeout) { return SDL_WaitEventTimeout(&event, timeout); },
+                []() { return SDL_GetTicks(); }, PowerSaver::getTimeout())
+            : SDL_PollEvent(&event);
+        if (RuntimeMedia::request().load(std::memory_order_relaxed) != 0) continue;
+		if (gotEvent)
 		{
 			do
 			{
diff --git a/es-core/src/RuntimeMedia.h b/es-core/src/RuntimeMedia.h
index 8ec207c..1ec1890 100644
--- a/es-core/src/RuntimeMedia.h
+++ b/es-core/src/RuntimeMedia.h
@@ -2,6 +2,7 @@
 #pragma once
 #include <atomic>
 #include <cstdio>
+#include <cstdint>
 #include <cstdlib>
 #include <string>
 #ifdef __linux__
@@ -55,5 +56,22 @@ inline void install() {
 inline void install() {}
 inline void publish() {}
 #endif
+// Preserve the power saver's original total timeout while polling the signal
+// mailbox. SDL may otherwise wait forever when its timeout is negative.
+template<class Wait, class Clock>
+int waitInterruptibly(Wait wait, Clock clock, int timeout) {
+    const std::uint32_t start = clock();
+    while (request().load(std::memory_order_relaxed) == 0) {
+        int slice = 100;
+        if (timeout >= 0) {
+            const std::uint32_t elapsed = clock() - start;
+            if (elapsed >= static_cast<std::uint32_t>(timeout)) return wait(0);
+            const int remaining = timeout - static_cast<int>(elapsed);
+            if (remaining < slice) slice = remaining;
+        }
+        if (wait(slice)) return 1;
+    }
+    return 0;
+}
 inline void external(bool value) { lifecycle().external(value); publish(); }
 }
