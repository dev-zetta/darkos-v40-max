 #include "NetworkThread.h"
 #include "scrapers/ThreadedScraper.h"
 #include "ImageIO.h"
@@ -694,8 +696,35 @@ int main(int argc, char* argv[])
 
 	bool running = true;
 
+    RuntimeMedia::install();
 	while(running)
 	{
+        const int mediaRequest = RuntimeMedia::request().exchange(0);
+        if (mediaRequest == 3) { running = false; break; }
+        if (mediaRequest == 1) {
+            RuntimeMedia::lifecycle().suspend([&]() {
+                window.suspendMedia();
+                AudioManager::getInstance()->deinit();
+                VolumeControl::getInstance()->deinit();
+            });
+            RuntimeMedia::publish();
+        } else if (mediaRequest == 2) {
+            RuntimeMedia::lifecycle().resume([&]() {
+                VolumeControl::getInstance()->init();
+                AudioManager::getInstance()->init();
+                window.reactivateGui();
+                window.normalizeNextUpdate();
+                if (Settings::getInstance()->getBool("audio.bgmusic"))
+                    AudioManager::getInstance()->playRandomMusic();
+            });
+            RuntimeMedia::publish();
+            lastTime = SDL_GetTicks();
+        }
+        if (RuntimeMedia::lifecycle().suspended()) {
+            SDL_Delay(20);
+            continue;
+        }
+
 		int processStart = SDL_GetTicks();
 
 		SDL_Event event;
@@ -806,6 +835,8 @@ int main(int argc, char* argv[])
 	FreeImage_DeInitialise();
 #endif
 
+	AudioManager::getInstance()->deinit();
+	VolumeControl::getInstance()->deinit();
 	window.deinit(true);
 
 	processQuitMode();
diff --git a/es-core/src/RuntimeMedia.h b/es-core/src/RuntimeMedia.h
new file mode 100644
index 0000000..8ec207c
--- /dev/null
+++ b/es-core/src/RuntimeMedia.h
@@ -0,0 +1,59 @@
+// V40 runtime integration. Main-thread lifecycle; no SDL calls in signal handlers.
+#pragma once
+#include <atomic>
+#include <cstdio>
+#include <cstdlib>
+#include <string>
+#ifdef __linux__
+#include <signal.h>
+#include <unistd.h>
+#endif
+
+namespace RuntimeMedia {
+class Lifecycle {
+public:
+    template<class Close> void suspend(Close close) {
+        if (mState == Active) { close(); mState = Suspended; }
+    }
+    template<class Open> void resume(Open open) {
+        if (mState == Suspended) { open(); mState = Active; }
+    }
+    void external(bool value) { mState = value ? External : Active; }
+    bool suspended() const { return mState == Suspended; }
+    const char* name() const { return mState == Active ? "active" : mState == Suspended ? "suspended" : "external"; }
+private:
+    enum State { Active, Suspended, External };
+    State mState = Active;
+};
+inline Lifecycle& lifecycle() { static Lifecycle state; return state; }
+inline std::atomic<int>& request() { static std::atomic<int> pending(0); return pending; }
+#ifdef __linux__
+static_assert(ATOMIC_INT_LOCK_FREE == 2, "Signal mailbox must be lock-free");
+inline void signalHandler(int signal) { request().store(signal == SIGTERM ? 3 : signal == SIGUSR1 ? 1 : 2, std::memory_order_relaxed); }
+inline void publish() {
+    const char* dir = std::getenv("XDG_RUNTIME_DIR");
+    if (!dir || !std::getenv("ES_MANAGED_SHUTDOWN")) return;
+    const std::string path = std::string(dir) + "/media-state";
+    const std::string temp = path + ".tmp";
+    FILE* file = std::fopen(temp.c_str(), "w");
+    if (!file) return;
+    std::fprintf(file, "%ld %s\n", static_cast<long>(getpid()), lifecycle().name());
+    if (std::fclose(file) == 0) std::rename(temp.c_str(), path.c_str());
+}
+inline void install() {
+    (void) request(); // Initialize before registering asynchronous handlers.
+    struct sigaction action = {};
+    action.sa_handler = signalHandler;
+    sigemptyset(&action.sa_mask);
+    action.sa_flags = SA_RESTART;
+    sigaction(SIGUSR1, &action, nullptr);
+    sigaction(SIGUSR2, &action, nullptr);
+    sigaction(SIGTERM, &action, nullptr);
+    publish();
+}
+#else
+inline void install() {}
+inline void publish() {}
+#endif
+inline void external(bool value) { lifecycle().external(value); publish(); }
+}
