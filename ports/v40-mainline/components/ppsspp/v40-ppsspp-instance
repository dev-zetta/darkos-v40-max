#!/usr/bin/env python3
# SPDX-License-Identifier: MIT
"""Guard standard V40 PPSSPP launches against orphaned instance counters."""
import fcntl
import os
from pathlib import Path
import stat
import sys


LAUNCHER = Path("/usr/local/libexec/v40-ppsspp-launcher")
COUNTER = Path("/dev/shm/PPSSPP_ID")
EMULATORS = {"ppsspp", "ppssppsdl", "ppssppqt"}


def running_emulator(proc, uid):
    for process in proc.iterdir():
        if not process.name.isdecimal():
            continue
        try:
            if process.stat().st_uid != uid:
                continue
            try:
                name = Path(os.readlink(process / "exe")).name
                name = name.removesuffix(" (deleted)")
            except PermissionError:
                name = (process / "comm").read_text().strip()
            if name.casefold() in EMULATORS:
                return True
        except (FileNotFoundError, ProcessLookupError, PermissionError):
            continue
    return False


def owned_regular_file(info, uid):
    return stat.S_ISREG(info.st_mode) and info.st_uid == uid and info.st_nlink == 1


def clear_counter(counter, proc, uid):
    if running_emulator(proc, uid):
        raise RuntimeError("A standalone PPSSPP process is already running")
    try:
        info = counter.lstat()
    except FileNotFoundError:
        return False
    if not owned_regular_file(info, uid) or info.st_size not in (
        0, max(4096, os.sysconf("SC_PAGE_SIZE"))
    ):
        raise RuntimeError("Unexpected PPSSPP instance counter object")
    counter.unlink(missing_ok=True)
    return True


def open_lock(directory, uid):
    directory.mkdir(mode=0o700, parents=True, exist_ok=True)
    folder_fd = os.open(directory, os.O_RDONLY | os.O_DIRECTORY | os.O_NOFOLLOW)
    try:
        info = os.fstat(folder_fd)
        if info.st_uid != uid or info.st_mode & 0o022:
            raise RuntimeError("Unexpected PPSSPP lock directory")
        return os.open(
            "launcher.lock", os.O_RDWR | os.O_CREAT | os.O_NOFOLLOW | os.O_NONBLOCK,
            0o600, dir_fd=folder_fd,
        )
    finally:
        os.close(folder_fd)


def launch(args, launcher=LAUNCHER, counter=COUNTER, proc=Path("/proc"), lock_dir=None):
    command = ["/bin/bash", str(launcher), *args]
    if args[:1] != ["standalone"] or len(args) < 2:
        os.execv(command[0], command)

    if lock_dir is None:
        lock_dir = Path.home() / ".cache" / "v40-ppsspp"
    uid = os.getuid()
    lock = open_lock(lock_dir, uid)
    try:
        if not owned_regular_file(os.fstat(lock), uid):
            raise RuntimeError("Unexpected PPSSPP launch lock")
        try:
            fcntl.flock(lock, fcntl.LOCK_EX | fcntl.LOCK_NB)
        except BlockingIOError as error:
            raise RuntimeError("Another standalone PSP launch is in progress") from error
        if clear_counter(counter, proc, uid):
            print("V40 PPSSPP: recovered orphaned shared instance counter", flush=True)
        # Keep the lock through the original launcher's setup, game and cleanup.
        os.set_inheritable(lock, True)
        os.execv(command[0], command)
    finally:
        os.close(lock)


def main():
    try:
        launch(sys.argv[1:])
    except (RuntimeError, OSError) as error:
        print(f"V40 PPSSPP: {error}", file=sys.stderr)
        raise SystemExit(75) from error


if __name__ == "__main__":
    main()
