+/* The external DC input is independent of the PMIC USB plug detector. */
+static bool rk817_external_power_present(struct rk817_charger *charger)
+{
+	return READ_ONCE(charger->plugged_in) || READ_ONCE(charger->dc_present);
+}
+
+/* Called only by the existing monitor; no additional GPIO IRQ/state writer. */
+static bool rk817_update_dc_present(struct rk817_charger *charger)
+{
+	bool old_present = READ_ONCE(charger->dc_present);
+	int present;
+
+	if (!charger->dc_detect_gpio)
+		return false;
+
+	present = gpiod_get_value_cansleep(charger->dc_detect_gpio);
+	if (present < 0) {
+		dev_warn_ratelimited(charger->dev,
+				    "Unable to read DC presence GPIO: %d\n",
+				    present);
+		return false;
+	}
+
+	WRITE_ONCE(charger->dc_present, !!present);
+	return old_present != !!present;
+}
