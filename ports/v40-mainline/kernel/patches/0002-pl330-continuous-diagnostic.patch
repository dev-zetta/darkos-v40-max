 /*
+ * Continuous LC0-period / LC1-burst ring derived from the April 2022
+ * Rockchip proposal by Huibin Hong and Sugar Zhang, and the retained BSP.
+ * Earlier cyclic-ring work: Alexander Kochetkov (2017).
+ * https://lkml.iu.edu/2204.3/04807.html
+ *
+ * Keep current mainline _bursts(), including FLUSHP/quirk semantics. Unlike
+ * the general proposal, this diagnostic is selected only for the observed
+ * two- or four-period V40 playback geometry. No dregs or period-body unrolling.
+ */
+static int _setup_continuous(struct pl330_dmac *pl330, unsigned dry_run,
+			     u8 buf[], const struct _xfer_spec *pxs, int ev)
+{
+	struct dma_pl330_desc *desc = pxs->desc;
+	struct pl330_xfer *x = &desc->px;
+	struct _arg_LPEND end = { .cond = ALWAYS };
+	u32 burst_bytes = BRST_SIZE(pxs->ccr) * BRST_LEN(pxs->ccr);
+	u32 periods, bursts, body, jump0, jump1, forever;
+	int off = 0;
+
+	if (!x->bytes || !desc->ring_bytes || !burst_bytes ||
+	    desc->ring_bytes % x->bytes || x->bytes % burst_bytes ||
+	    desc->rqtype != DMA_MEM_TO_DEV || !desc->rqcfg.src_inc ||
+	    desc->rqcfg.dst_inc)
+		return -EINVAL;
+	periods = desc->ring_bytes / x->bytes;
+	bursts = x->bytes / burst_bytes;
+	if (!periods || periods > 256 || !bursts || bursts > 256)
+		return -EINVAL;
+
+	/* Validate every u8 backward displacement before emitting any byte. */
+	body = _bursts(pl330, 1, buf, pxs, 1);
+	jump1 = body;
+	jump0 = SZ_DMALP + body + SZ_DMALPEND + SZ_DMASEV;
+	forever = 2 * SZ_DMAMOV + SZ_DMALP + jump0 + SZ_DMALPEND;
+	if (jump1 > U8_MAX || jump0 > U8_MAX || forever > U8_MAX)
+		return -E2BIG;
+
+	off += _emit_MOV(dry_run, &buf[off], SAR, x->src_addr);
+	off += _emit_MOV(dry_run, &buf[off], DAR, x->dst_addr);
+	off += _emit_LP(dry_run, &buf[off], 0, periods);
+	off += _emit_LP(dry_run, &buf[off], 1, bursts);
+	off += _bursts(pl330, dry_run, &buf[off], pxs, 1);
+	end.loop = 1;
+	end.bjump = jump1;
+	off += _emit_LPEND(dry_run, &buf[off], &end);
+	off += _emit_SEV(dry_run, &buf[off], ev);
+	end.loop = 0;
+	end.bjump = jump0;
+	off += _emit_LPEND(dry_run, &buf[off], &end);
+	end.loop = 1;
+	end.forever = true;
+	end.bjump = forever;
+	off += _emit_LPEND(dry_run, &buf[off], &end);
+	return off;
+}
