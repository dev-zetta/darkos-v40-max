+/* Caller holds pch->lock. Never retain a descriptor across a client callback. */
+static void pl330_continuous_callbacks(struct dma_pl330_chan *pch,
+				       unsigned long *flags)
+{
+	unsigned int budget = 32;
+
+	while (budget) {
+		struct dma_pl330_desc *desc, *found = NULL;
+		struct dmaengine_desc_callback cb;
+		bool pending = false;
+
+		list_for_each_entry(desc, &pch->work_list, node)
+			if (desc->continuous && desc->status == BUSY) {
+				found = desc;
+				break;
+			}
+		if (!found)
+			break;
+		spin_lock(&pch->dmac->lock);
+		if (!found->continuous_fault && found->period_pending) {
+			found->period_pending--;
+			dmaengine_desc_get_callback(&found->txd, &cb);
+			pending = true;
+		}
+		spin_unlock(&pch->dmac->lock);
+		if (!pending)
+			break;
+		budget--;
+		spin_unlock_irqrestore(&pch->lock, *flags);
+		if (dmaengine_desc_callback_valid(&cb))
+			dmaengine_desc_callback_invoke(&cb, NULL);
+		spin_lock_irqsave(&pch->lock, *flags);
+		/* terminate/reprepare may have recycled found; rescan from the head. */
+	}
+	if (!budget)
+		tasklet_schedule(&pch->task);
+}
