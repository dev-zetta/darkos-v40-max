+/* Candidate-only bounded stop; caller holds the DMAC lock and a PM ref. */
+static int pl330_continuous_stop(struct pl330_thread *thrd)
+{
+	void __iomem *regs = thrd->dmac->base;
+	u8 insn[6] = { 0 };
+	u32 state;
+	int ret;
+
+	writel(readl(regs + INTEN) & ~BIT(thrd->ev), regs + INTEN);
+	writel(BIT(thrd->ev), regs + INTCLR);
+	ret = readl_poll_timeout_atomic(regs + CS(thrd->id), state,
+		(state & 0xf) != DS_ST_FLTCMP, 1, 5000);
+	if (ret)
+		return ret;
+	state &= 0xf;
+	if (state != DS_ST_STOP && state != DS_ST_KILL && state != DS_ST_CMPLT) {
+		_emit_KILL(0, insn);
+		_execute_DBGINSN(thrd, insn, false);
+	}
+	ret = readl_poll_timeout_atomic(regs + CS(thrd->id), state,
+		(state & 0xf) == DS_ST_STOP, 1, 5000);
+	writel(BIT(thrd->ev), regs + INTCLR);
+	return ret;
+}
+
+static bool pl330_thread_continuous(struct pl330_thread *thrd)
+{
+	return (thrd->req[0].desc && thrd->req[0].desc->continuous) ||
+		(thrd->req[1].desc && thrd->req[1].desc->continuous);
+}
+
+/* A zero/stale SAR must not underflow the ring or manufacture a new wrap. */
+static u32 pl330_continuous_position(struct dma_pl330_desc *desc, u32 address)
+{
+	u64 start = desc->px.src_addr;
+
+	if (desc->ring_bytes && address >= start &&
+	    (u64)address <= start + desc->ring_bytes)
+		desc->continuous_pos = (address - start) % desc->ring_bytes;
+	return desc->continuous_pos;
+}
+
+/* Called only for serviced period events with dmac->lock held. */
+static void pl330_continuous_event(struct dma_pl330_desc *desc)
+{
+	if (desc->continuous_fault || desc->status != BUSY)
+		return;
+	if (desc->period_pending == U32_MAX) {
+		desc->continuous_fault = true;
+		desc->period_pending = 0;
+	} else {
+		desc->period_pending++;
+	}
+	tasklet_schedule(&desc->pchan->task);
+}
