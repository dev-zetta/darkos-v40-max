+static void rockchip_i2s_v40_put_clk(void *data)
+{
+	clk_put(data);
+}
+
+static int rockchip_i2s_v40_limit_frac_input(struct rk_i2s_dev *i2s)
+{
+	struct clk_hw *mux, *src;
+	struct clk *clk;
+	int ret;
+
+	if (!of_machine_is_compatible("v40-port,rk3326-handheld") ||
+	    !of_device_is_compatible(i2s->dev->of_node, "rockchip,px30-i2s") ||
+	    strcmp(__clk_get_name(i2s->mclk), "clk_i2s1"))
+		return 0;
+
+	mux = clk_hw_get_parent(__clk_get_hw(i2s->mclk));
+	src = mux ? clk_hw_get_parent_by_index(mux, 0) : NULL;
+	if (!src || strcmp(clk_hw_get_name(src), "clk_i2s1_src"))
+		return -EINVAL;
+
+	clk = clk_hw_get_clk(src, "i2s1-frac-src");
+	if (IS_ERR(clk))
+		return PTR_ERR(clk);
+
+	ret = devm_add_action_or_reset(i2s->dev, rockchip_i2s_v40_put_clk, clk);
+	if (ret)
+		return ret;
+
+	/*
+	 * The PX30 TRM limits the fractional divider input to 600 MHz.
+	 * On the V40 this is GPLL (1.2 GHz) divided by two, which also
+	 * leaves enough headroom for the 96 kHz RK817 MCLK.
+	 *
+	 * Wait until the CRU has protected its critical clocks: a rate
+	 * change may temporarily ungate the fractional clock's parents.
+	 * Set the range before ASoC programs MCLK so an inherited nominal
+	 * rate cannot cause the initial rate request to skip programming.
+	 */
+	ret = clk_set_rate_range(clk, PX30_I2S1_FRAC_INPUT_MAX,
+				 PX30_I2S1_FRAC_INPUT_MAX);
+	if (ret)
+		return ret;
+	if (clk_get_rate(clk) != PX30_I2S1_FRAC_INPUT_MAX)
+		return -ERANGE;
+
+	dev_info(i2s->dev, "V40 I2S1 fractional input set to %lu Hz\n",
+		 PX30_I2S1_FRAC_INPUT_MAX);
+	return 0;
+}
+
 static int rockchip_i2s_probe(struct platform_device *pdev)
 {
 	struct device_node *node = pdev->dev.of_node;
@@ -827,6 +880,11 @@
 	if (ret)
 		return ret;
 
+	ret = rockchip_i2s_v40_limit_frac_input(i2s);
+	if (ret)
+		return dev_err_probe(&pdev->dev, ret,
+				     "Failed to constrain V40 I2S1 clock\n");
+
