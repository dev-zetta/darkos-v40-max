+static int rk817_v40_dacmt_powerdown(struct snd_soc_dapm_widget *widget,
+				   struct snd_kcontrol *control, int event)
+{
+	struct snd_soc_component *component =
+		snd_soc_dapm_to_component(widget->dapm);
+	int ret;
+
+	if (event != SND_SOC_DAPM_PRE_PMD)
+		return 0;
+
+	ret = snd_soc_component_update_bits(component,
+			RK817_CODEC_DDAC_MUTE_MIXCTL,
+			DACMT_MASK, DACMT_ENABLE);
+	return ret < 0 ? ret : 0;
+}
+
+/*
+ * The normal stream prepare path unmutes after DAPM power-up. Do not let a
+ * supply widget clear the same bit earlier in that sequence. Keep the graph
+ * and its names intact; only this private device's register ownership changes.
+ * Retain an assert-only mute on power-down, including DAPM-only shutdown.
+ */
+static int rk817_v40_dacmt_widgets(struct device *dev,
+				 struct rk817_codec_priv *rk817)
+{
+	struct snd_soc_dapm_widget *widgets;
+	unsigned int i, found = 0;
+
+	if (!v40_dacmt_guard || !rk817->v40_volume)
+		return 0;
+
+	widgets = devm_kmemdup(dev, rk817_dapm_widgets,
+			       sizeof(rk817_dapm_widgets), GFP_KERNEL);
+	if (!widgets)
+		return -ENOMEM;
+
+	for (i = 0; i < ARRAY_SIZE(rk817_dapm_widgets); i++) {
+		if (strcmp(widgets[i].name, "DAC Mute Off"))
+			continue;
+		if (widgets[i].id != snd_soc_dapm_supply ||
+		    widgets[i].reg != RK817_CODEC_DDAC_MUTE_MIXCTL ||
+		    widgets[i].shift != 0 || widgets[i].mask != 1 ||
+		    widgets[i].on_val != 0 || widgets[i].off_val != 1 ||
+		    widgets[i].event || widgets[i].event_flags)
+			return -EINVAL;
+		widgets[i].reg = SND_SOC_NOPM;
+		widgets[i].event = rk817_v40_dacmt_powerdown;
+		widgets[i].event_flags = SND_SOC_DAPM_PRE_PMD;
+		found++;
+	}
+	if (found != 1)
+		return -EINVAL;
+
+	rk817->component_driver.dapm_widgets = widgets;
+	rk817->v40_dacmt_guard = true;
+	return 0;
+}
