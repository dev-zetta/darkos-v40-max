#!/usr/bin/python3
"""Serialize power transactions, including the asynchronous suspend service."""
import fcntl
from pathlib import Path
import subprocess
import sys
import time

def request(action):
    if action not in ('suspend','poweroff','reboot'): raise ValueError('Unsupported power action')
    lock=Path('/run/v40max-power.lock').open('w')
    try: fcntl.flock(lock,fcntl.LOCK_EX|fcntl.LOCK_NB)
    except BlockingIOError:
        print('v40max: another power request is in progress',flush=True)
        return 0
    def state():
        return subprocess.run(['systemctl','show','systemd-suspend.service','--property=ActiveState','--value'],check=True,text=True,capture_output=True).stdout.strip()
    if action=='suspend' and state() in ('activating','active','deactivating'):
        print('v40max: suspend already in progress',flush=True)
        return 0
    result=subprocess.run(['systemctl',action]).returncode
    if result or action!='suspend': return result
    deadline=time.monotonic()+10
    started=False
    while time.monotonic()<deadline:
        current=state()
        if current in ('activating','active','deactivating'):
            started=True
            deadline=time.monotonic()+10
        elif started: break
        time.sleep(.1)
    return 0

if __name__=='__main__': sys.exit(request(sys.argv[1]))
