+  else
+    echo "$1" > /sys/devices/platform/${gpu}.gpu/devfreq/${gpu}.gpu/governor
+  fi
   echo "$1" > /sys/devices/system/cpu/cpufreq/policy0/scaling_governor
   echo "$1" > /sys/devices/platform/dmc/devfreq/dmc/governor
 else
