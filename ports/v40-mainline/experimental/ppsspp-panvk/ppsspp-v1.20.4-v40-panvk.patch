+bool SDLVulkanGraphicsContext::AcquireKMSDRMDisplay(int cardIndex, std::string *error) {
+	if (cardIndex < 0) {
+		*error = "SDL did not identify a KMS device";
+		return false;
+	}
+
+	const VkInstance instance = vulkan_->GetInstance();
+	const VkPhysicalDevice physicalDevice = vulkan_->GetCurrentPhysicalDevice();
+	auto getProperties2 = reinterpret_cast<PFN_vkGetPhysicalDeviceProperties2>(
+		PPSSPP_VK::vkGetInstanceProcAddr(instance, "vkGetPhysicalDeviceProperties2"));
+	if (!getProperties2 ||
+	    vulkan_->GetPhysicalDeviceProperties().properties.apiVersion < VK_API_VERSION_1_2) {
+		*error = "Direct KMS requires Vulkan 1.2 and Mesa PanVK";
+		return false;
+	}
+
+	VkPhysicalDeviceDriverProperties driver{VK_STRUCTURE_TYPE_PHYSICAL_DEVICE_DRIVER_PROPERTIES};
+	VkPhysicalDeviceProperties2 properties{VK_STRUCTURE_TYPE_PHYSICAL_DEVICE_PROPERTIES_2, &driver};
+	getProperties2(physicalDevice, &properties);
+	if (driver.driverID != VK_DRIVER_ID_MESA_PANVK) {
+		*error = "This direct KMS mode requires the Mesa PanVK ICD";
+		return false;
+	}
+
+	auto getDisplay = reinterpret_cast<PFN_vkGetDrmDisplayEXT>(
+		PPSSPP_VK::vkGetInstanceProcAddr(instance, "vkGetDrmDisplayEXT"));
+	auto acquireDisplay = reinterpret_cast<PFN_vkAcquireDrmDisplayEXT>(
+		PPSSPP_VK::vkGetInstanceProcAddr(instance, "vkAcquireDrmDisplayEXT"));
+	auto releaseDisplay = reinterpret_cast<PFN_vkReleaseDisplayEXT>(
+		PPSSPP_VK::vkGetInstanceProcAddr(instance, "vkReleaseDisplayEXT"));
+	if (!getDisplay || !acquireDisplay || !releaseDisplay) {
+		*error = "PanVK is missing direct DRM display entry points";
+		return false;
+	}
+
+	const std::string card = "card" + std::to_string(cardIndex);
+	const char *connector = std::getenv("PPSSPP_KMSDRM_CONNECTOR");
+	const auto id = FindSDLKMSDRMConnector("/sys/class/drm", card, connector ? connector : "", error);
+	if (!id)
+		return false;
+
+	const std::string device = "/dev/dri/" + card;
+	// The primary node grants master on open only if no process already owns it.
+	const int fd = open(device.c_str(), O_RDWR | O_CLOEXEC | O_NOFOLLOW);
+	if (fd < 0) {
+		*error = "Could not open " + device + ": " + std::strerror(errno);
+		return false;
+	}
+
+	VkDisplayKHR display = VK_NULL_HANDLE;
+	const VkResult lookup = getDisplay(physicalDevice, fd, *id, &display);
+	if (lookup != VK_SUCCESS || display == VK_NULL_HANDLE) {
+		close(fd);
+		*error = "PanVK could not look up the connected KMS output (VkResult " + std::to_string(lookup) + ")";
+		return false;
+	}
+
+	const VkResult acquired = acquireDisplay(physicalDevice, fd, display);
+	if (acquired != VK_SUCCESS) {
+		close(fd);
+		*error = "PanVK could not acquire KMS display master (VkResult " + std::to_string(acquired) + ")";
+		return false;
+	}
+
+	// Mesa PanVK retains the acquired descriptor until vkReleaseDisplayEXT closes it.
+	acquiredDisplay_ = display;
+	releaseDisplay_ = releaseDisplay;
+	fprintf(stderr, "PanVK direct KMS acquired %s connector %u with %s\n", device.c_str(), *id, properties.properties.deviceName);
+	return true;
+}
