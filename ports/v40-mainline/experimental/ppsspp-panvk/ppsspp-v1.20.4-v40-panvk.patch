diff --git a/SDL/README.kmsdrm-panvk.md b/SDL/README.kmsdrm-panvk.md
new file mode 100644
index 0000000000000000000000000000000000000000..9be06b1064fd1fc90eebe8b51e9cf4e3f5baf2a9
--- /dev/null
+++ b/SDL/README.kmsdrm-panvk.md
@@ -0,0 +1,7 @@
+# Direct KMS with Mesa PanVK
+
+Build SDL PPSSPP with `-DUSE_VULKAN_DISPLAY_KHR=ON`. To run with Mesa PanVK on a Linux console, select the Vulkan graphics backend and launch the emulator with `SDL_VIDEODRIVER=KMSDRM` and `PPSSPP_KMSDRM_PANVK=1`. Use `VK_DRIVER_FILES` to select the intended Mesa PanVK ICD. The ICD must provide `VK_KHR_display`, `VK_EXT_direct_mode_display` and `VK_EXT_acquire_drm_display`.
+
+PPSSPP uses the DRM card selected by SDL. If several connectors are connected, set `PPSSPP_KMSDRM_CONNECTOR` to the connector name under `/sys/class/drm` without the `cardN-` prefix. The launcher must release its display before starting PPSSPP. Opt-in Vulkan availability, display acquisition, or swapchain initialization failure returns status `69` before PPSSPP starts the emulation thread. A launcher can wait for PPSSPP to exit and then run a fresh GLES process with the PanVK environment removed. Other application failures, signals, and exits retain their usual status. Launchers must never retry with GLES after a Vulkan game session has started. The environment setting leaves ordinary PPSSPP launches unchanged.
+
+Bifrost support may be experimental in Mesa. Use the PanVK build and environment recommended by the distributor for the hardware in use. A DRM connector and an advertised Vulkan device establish graphics availability. Actual game speed, rendering correctness and audio should be checked on the target hardware.
diff --git a/SDL/SDLKMSDRMConnector.h b/SDL/SDLKMSDRMConnector.h
new file mode 100644
index 0000000000000000000000000000000000000000..7fb53ce9df42d4bbcd8c4eae88a4043ed8d240a7
--- /dev/null
+++ b/SDL/SDLKMSDRMConnector.h
@@ -0,0 +1,51 @@
+#pragma once
+
+#include <charconv>
+#include <cstdint>
+#include <filesystem>
+#include <fstream>
+#include <optional>
+#include <string>
+#include <string_view>
+
+inline std::optional<uint32_t> FindSDLKMSDRMConnector(const std::filesystem::path &sysfs, std::string_view card,
+	std::string_view requested, std::string *error) {
+	const std::string prefix = std::string(card) + "-";
+	std::error_code ec;
+	std::optional<uint32_t> selected;
+	for (std::filesystem::directory_iterator it(sysfs, ec), end; !ec && it != end; it.increment(ec)) {
+		const std::string name = it->path().filename().string();
+		if (name.compare(0, prefix.size(), prefix) != 0 ||
+		    (!requested.empty() && std::string_view(name).substr(prefix.size()) != requested)) {
+			continue;
+		}
+
+		std::string status;
+		std::ifstream(it->path() / "status") >> status;
+		if (status != "connected")
+			continue;
+
+		std::string objectId;
+		std::ifstream(it->path() / "connector_id") >> objectId;
+		uint32_t id = 0;
+		const char *endId = objectId.data() + objectId.size();
+		const auto parsed = std::from_chars(objectId.data(), endId, id);
+		if (parsed.ec != std::errc{} || parsed.ptr != endId || id == 0) {
+			*error = "Cannot read connector ID for " + name;
+			return std::nullopt;
+		}
+		if (selected) {
+			*error = "Multiple connected KMS outputs. Set PPSSPP_KMSDRM_CONNECTOR to a connector name.";
+			return std::nullopt;
+		}
+		selected = id;
+	}
+
+	if (ec) {
+		*error = "Cannot enumerate DRM connectors: " + ec.message();
+		return std::nullopt;
+	}
+	if (!selected)
+		*error = "No matching connected KMS output for " + std::string(card);
+	return selected;
+}
