diff --git a/Core/Instance.cpp b/Core/Instance.cpp
index fcb350f82e275215b55f9e6a2c8af96f7892c535..4004355f5435047f4953fdd94d426e94beadc405 100644
--- a/Core/Instance.cpp
+++ b/Core/Instance.cpp
@@ -35,8 +35,91 @@
 
 #include <cstdint>
 
+#if PPSSPP_PLATFORM(LINUX) && !PPSSPP_PLATFORM(ANDROID) && !defined(__LIBRETRO__)
+#include <cerrno>
+#include <cstdio>
+#include <limits>
+#endif
+
 uint8_t PPSSPP_ID = 0;
 
+#if PPSSPP_PLATFORM(LINUX) && !PPSSPP_PLATFORM(ANDROID) && !defined(__LIBRETRO__)
+
+static int instanceLockFile = -1;
+static constexpr int kMaxInstanceId = std::numeric_limits<uint8_t>::max();
+
+static struct flock InstanceSlot(int id) {
+	struct flock lock{};
+	lock.l_type = F_WRLCK;
+	lock.l_whence = SEEK_SET;
+	lock.l_start = id;
+	lock.l_len = 1;
+	return lock;
+}
+
+int GetInstancePeerCount() {
+	if (instanceLockFile < 0) {
+		return 0;
+	}
+
+	// F_GETLK reports conflicting locks held by other processes.
+	int count = 1;
+	for (int id = 1; id <= kMaxInstanceId; ++id) {
+		if (id == PPSSPP_ID) {
+			continue;
+		}
+		struct flock lock = InstanceSlot(id);
+		if (fcntl(instanceLockFile, F_GETLK, &lock) == 0 && lock.l_type != F_UNLCK) {
+			++count;
+		}
+	}
+	return count;
+}
+
+void InitInstanceCounter() {
+	// Legacy builds write counters and unlink their shared object. Keep their
+	// object separate. Retain this inode so every opener sees the same locks.
+	char name[64];
+	std::snprintf(name, sizeof(name), "/PPSSPP_ID_LOCKS_V1_%lu", static_cast<unsigned long>(geteuid()));
+	instanceLockFile = shm_open(name, O_CREAT | O_RDWR, S_IRUSR | S_IWUSR);
+	if (instanceLockFile < 0) {
+		WARN_LOG(Log::sceNet, "Could not open PPSSPP instance lock file (errno %d).", errno);
+		PPSSPP_ID = 1;
+		return;
+	}
+
+	// The kernel releases the slot when its process exits, even on a crash.
+	// Locks may cover bytes beyond EOF, so the object itself holds no state.
+	for (int id = 1; id <= kMaxInstanceId; ++id) {
+		struct flock lock = InstanceSlot(id);
+		if (fcntl(instanceLockFile, F_SETLK, &lock) == 0) {
+			PPSSPP_ID = static_cast<uint8_t>(id);
+			return;
+		}
+		if (errno != EACCES && errno != EAGAIN) {
+			WARN_LOG(Log::sceNet, "Could not claim PPSSPP instance lock (errno %d).", errno);
+			ShutdownInstanceCounter();
+			PPSSPP_ID = 1;
+			return;
+		}
+	}
+
+	// IDs are stored in one byte. Keep primary-only audio and writes disabled
+	// if no unique ID remains.
+	WARN_LOG(Log::sceNet, "All PPSSPP instance IDs are in use.");
+	ShutdownInstanceCounter();
+	PPSSPP_ID = static_cast<uint8_t>(kMaxInstanceId);
+}
+
+void ShutdownInstanceCounter() {
+	if (instanceLockFile >= 0) {
+		close(instanceLockFile);
+		instanceLockFile = -1;
+	}
+}
+
